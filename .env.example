# ── Database (Neon via the Vercel Marketplace integration) ────────────────
# Pooled connection string, used by the app at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/silsilah"
# Direct (unpooled) connection string, used by `prisma migrate`.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/silsilah"
# Separate database for DB-backed tests. Tests truncate its tables; never point it at real data.
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/silsilah_test"

# ── Auth.js ───────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
# Needed when running `next start` outside Vercel (Vercel sets this up itself).
AUTH_TRUST_HOST=true

# ── Super admins ──────────────────────────────────────────────────────────
# Comma-separated emails. They sign in normally (magic link) and get /admin.
# Admins see app-wide stats only, never other people's trees.
ADMIN_EMAILS="admin-one@example.com,admin-two@example.com"

# ── Email (Resend; magic links and invitations) ──────────────────────────
# Leave empty locally: emails (including sign-in links) are printed to the server console.
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend. onboarding@resend.dev only delivers to your own Resend account email.
EMAIL_FROM="Silsilah <onboarding@resend.dev>"

# ── Storage (Vercel Blob, private store) — used from phase 2 ─────────────
BLOB_READ_WRITE_TOKEN=""

# ── AI (Anthropic) — used from phase 2 ───────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ── Cron ──────────────────────────────────────────────────────────────────
# Vercel sends this as a Bearer token to /api/cron/daily.
CRON_SECRET=""
