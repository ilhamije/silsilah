# ── Database (Neon via the Vercel Marketplace integration) ────────────────
# Pooled connection string, used by the app at runtime.
SIL7878_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/silsilah"
# Direct (unpooled) connection string, used by `prisma migrate`.
SIL7878_DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/silsilah"
# Separate database for DB-backed tests. Tests truncate its tables; never point it at real data.
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/silsilah_test"

# ── Auth.js ───────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
# Needed when running `next start` outside Vercel (Vercel sets this up itself).
AUTH_TRUST_HOST=true

# ── Super admins ──────────────────────────────────────────────────────────
# Comma-separated emails. They sign in normally (magic link) and get /admin.
# Admins see app-wide stats only, never other people's trees.
ADMIN_EMAILS="admin-one@example.com,admin-two@example.com"

# ── Email (Resend; magic links and invitations) ──────────────────────────
# From https://resend.com/api-keys (Sending access is enough).
# Leave empty locally: emails (including sign-in links) are printed to the server console.
RESEND_API_KEY=""
# Required when RESEND_API_KEY is set. Must be an address on a domain you verified
# at https://resend.com/domains. (Resend's test sender onboarding@resend.dev only
# delivers to your own Resend account address; don't use it in production.)
EMAIL_FROM="Silsilah <noreply@yourdomain.com>"

# ── Temporary password sign-in ────────────────────────────────────────────
# While email isn't set up: a shared password that signs in ANY email address
# (and creates the account if new) at /login/password. Anyone who knows it can
# sign in as any user, admins included. Leave empty to turn it off.
PASSWORD_LOGIN_SECRET=""

# ── AI (Anthropic) ────────────────────────────────────────────────────────
# Photos are sent here once to be read, then discarded; nothing is stored.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
# Max pages one user can have read per rolling 24 hours (protects your API budget).
EXTRACTION_DAILY_LIMIT=60
# Local development without an API key: return the sample fixtures instead of
# calling the AI. Ignored on Vercel production.
EXTRACTION_MOCK=1

# ── Cron ──────────────────────────────────────────────────────────────────
# Vercel sends this as a Bearer token to /api/cron/daily.
CRON_SECRET=""
